APP_ENV=local
# Replace CHANGE_ME_LOCAL before starting Compose; URL-encode special URL characters.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
DATABASE_URL=postgresql+psycopg://portfolio:CHANGE_ME_LOCAL@127.0.0.1:5432/portfolio
TEST_DATABASE_URL=postgresql+psycopg://portfolio:CHANGE_ME_LOCAL@127.0.0.1:5433/portfolio_test
REDIS_URL=redis://127.0.0.1:6379/0
ADMIN_USER_ID=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
AUTH_EPOCH=1
SESSION_TTL_SECONDS=3600
PUBLIC_ORIGIN=http://127.0.0.1:8000
RAG_ENABLED=false
